[user]
  name = Yamada Yuki
  email = yamadayuuki0818@gmail.com

[color]
  ui = auto
  status = always

[color "status"]
  added = green bold
  changed = yellow bold
  untracked = cyan
  branch = yellow bold ul

[alias]
  sync = !git fetch --prune && (git merge --ff-only @{u} 2>/dev/null || true) && git branch -vv | awk '/: gone]/{print $1}' | xargs -I % git branch -d %

[core]
  editor = vim
  pager = delta

[push]
  default = current

[diff]
  algorithm = histogram
  tool = vimdiff
  indentHeuristic = true

[interactive]
  diffFilter = delta --color-only

[ghq]
  root = ~/dev/src

[github]
  user = yamadayuki
  privatekey = $HOME/.ssh/id_rsa

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

[credential]
  helper = osxkeychain

[pull]
  ff = only

[delta]
  features = side-by-side line-numbers decorations
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = none
  plus-style = syntax "#004a00"
  plus-emph-style = syntax "#006400"
  plus-empty-line-marker-style = syntax "#004a00"

[rerere]
  enabled = true

[init]
  defaultBranch = main

[include]
  path = ~/.gitconfig.local

  helper = !gh auth git-credential
  helper = osxkeychain

# ---- core --------------------------------------------------------------------

[core]
  editor = vim
  pager = delta
  # 大きいリポジトリでも git status を速くする
  fsmonitor = true
  untrackedCache = true

[init]
  defaultBranch = main

[help]
  autocorrect = prompt

[alias]
  sync = !git fetch && (git merge --ff-only @{u} 2>/dev/null || true) && git branch -vv | awk '/: gone]/{print $1}' | xargs -I % git branch -d %
  lg = log --graph --pretty=compact

# ---- appearance --------------------------------------------------------------
# local = blue, remote = magenta (VSCode の Source Control Graph に寄せる)

[color "status"]
  added = green bold
  changed = yellow bold
  untracked = cyan
  branch = blue bold ul
  localBranch = blue bold
  remoteBranch = magenta bold

[color "decorate"]
  HEAD = bold cyan
  branch = bold blue
  remoteBranch = bold magenta
  tag = bold yellow
  stash = bold green

[color "branch"]
  current = bold blue
  remote = magenta
  upstream = magenta

[pretty]
  # hash subject author date (refs)
  compact = %C(auto)%h%C(reset) %C(bold)%s%C(reset) %C(blue)%an%C(reset) %C(dim)%ar%C(reset)%C(auto)%(decorate:pointer= → )%C(reset)
  # hash (refs) subject / author date / body
  detail = format:%C(auto)%h%(decorate:pointer= → )%C(reset) %C(bold)%s%C(reset)%n%C(blue)%an%C(reset) %C(dim)%ad (%ar)%C(reset)%n%w(0,4,4)%+b%w(0,0,0)

[format]
  pretty = detail

[log]
  date = format-local:%Y-%m-%d %H:%M
  graphColors = blue, magenta, yellow, cyan, green, red

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[status]
  showStash = true

[grep]
  lineNumber = true
  patternType = perl

# ---- diff / merge ------------------------------------------------------------

[diff]
  algorithm = histogram
  tool = vimdiff
  colorMoved = default
  colorMovedWS = allow-indentation-change

[difftool]
  prompt = false

[diff "image"]
  textconv = magick identify -format \"%m %wx%h %b\\n\"

[merge]
  conflictStyle = zdiff3
  autoStash = true

[rerere]
  enabled = true
  autoUpdate = true

[interactive]
  diffFilter = delta --color-only

[delta]
  features = side-by-side line-numbers decorations
  navigate = true
  hyperlinks = true
  hyperlinks-file-link-format = "vscode://file/{path}:{line}"
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = none
  plus-style = syntax "#004a00"
  plus-emph-style = syntax "#006400"
  plus-empty-line-marker-style = syntax "#004a00"

# ---- remote workflow ---------------------------------------------------------

[fetch]
  prune = true
  writeCommitGraph = true

[pull]
  ff = only

[push]
  default = current
  autoSetupRemote = true
  followTags = true
  useForceIfIncludes = true

[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true

[commit]
  verbose = true

# ---- tools -------------------------------------------------------------------

[ghq]
  root = ~/dev/src

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

# machine-local overrides (must stay last)
[include]
  path = ~/.gitconfig.local
